# Copy this file to ".env" (same folder) and edit. ".env" is git-ignored: never commit real passwords.
# The defaults below match the Docker container from docker-compose.yml, so you can usually skip this file.

# --- Cassandra connection (used by the Python driver AND by Spark) ---
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=f1_analysis
# Leave empty for the default Docker container (no authentication).
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# --- Spark Cassandra Connector ---
# true  = start Spark with the connector (downloaded from Maven Central on first start; needs internet)
# false = Spark works without Cassandra (the 6 CSV-based pages still work)
SPARK_CASSANDRA_ENABLED=true
# Spark 3.5.x uses Scala 2.12 -> connector 3.5.x built for Scala 2.12
SPARK_CASSANDRA_CONNECTOR_PACKAGE=com.datastax.spark:spark-cassandra-connector_2.12:3.5.1
# Offline machine? Download the connector assembly JAR yourself and put its full path here
# (this overrides the package above), e.g. jars\spark-cassandra-connector-assembly_2.12-3.5.1.jar
SPARK_CASSANDRA_CONNECTOR_JAR=

# --- Dataset folder (default: .\data) ---
F1_DATA_DIR=
