-- Apache Cassandra schema for the Formula 1 analysis project.
-- Generated by `python cassandra_schema.py --write` - edit cassandra_schema.py, not this file.
-- Safe to run repeatedly: every statement uses IF NOT EXISTS, nothing is dropped or truncated.
-- SimpleStrategy / replication_factor 1 is for a single-node development machine only.

CREATE KEYSPACE IF NOT EXISTS f1_analysis
    WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};


-- drivers: Driver master data (one row per driver).
-- Query: Look up a driver by id.
CREATE TABLE IF NOT EXISTS f1_analysis.drivers (
    driver_id int,
    driver_ref text,
    car_number int,
    code text,
    forename text,
    surname text,
    dob date,
    nationality text,
    url text,
    PRIMARY KEY (driver_id)
);

-- constructors: Constructor (team) master data.
-- Query: Look up a constructor by id.
CREATE TABLE IF NOT EXISTS f1_analysis.constructors (
    constructor_id int,
    constructor_ref text,
    name text,
    nationality text,
    url text,
    PRIMARY KEY (constructor_id)
);

-- circuits: Circuit master data (location, country, coordinates).
-- Query: Look up a circuit by id.
CREATE TABLE IF NOT EXISTS f1_analysis.circuits (
    circuit_id int,
    circuit_ref text,
    name text,
    location text,
    country text,
    lat double,
    lng double,
    alt double,
    url text,
    PRIMARY KEY (circuit_id)
);

-- seasons: List of championship seasons.
-- Query: List all seasons.
CREATE TABLE IF NOT EXISTS f1_analysis.seasons (
    year int,
    url text,
    PRIMARY KEY (year)
);

-- status: Finishing-status lookup (Finished, Accident, +1 Lap, ...).
-- Query: Translate a status_id into text.
CREATE TABLE IF NOT EXISTS f1_analysis.status (
    status_id int,
    status_name text,
    PRIMARY KEY (status_id)
);

-- races: Race calendar keyed by race_id.
-- Query: Look up one race by race_id (name, season, round, circuit).
CREATE TABLE IF NOT EXISTS f1_analysis.races (
    race_id int,
    year int,
    round int,
    circuit_id int,
    name text,
    race_date date,
    race_time text,
    url text,
    PRIMARY KEY (race_id)
);

-- races_by_season: Same race data denormalised by season (Cassandra duplicates data per query).
-- Query: List all races of a season in round order.
CREATE TABLE IF NOT EXISTS f1_analysis.races_by_season (
    race_id int,
    year int,
    round int,
    circuit_id int,
    name text,
    race_date date,
    race_time text,
    url text,
    PRIMARY KEY (year, round)
);

-- results_by_race: Race results, partitioned by race.
-- Query: Get every result of one race.
CREATE TABLE IF NOT EXISTS f1_analysis.results_by_race (
    result_id int,
    race_id int,
    driver_id int,
    constructor_id int,
    car_number int,
    grid int,
    position int,
    position_text text,
    position_order int,
    points double,
    laps int,
    finish_time text,
    milliseconds bigint,
    fastest_lap int,
    fastest_lap_rank int,
    fastest_lap_time text,
    fastest_lap_speed double,
    status_id int,
    PRIMARY KEY (race_id, result_id)
);

-- results_by_driver: Race results duplicated by driver for career queries.
-- Query: Get a driver's whole career, ordered by race.
CREATE TABLE IF NOT EXISTS f1_analysis.results_by_driver (
    result_id int,
    race_id int,
    driver_id int,
    constructor_id int,
    car_number int,
    grid int,
    position int,
    position_text text,
    position_order int,
    points double,
    laps int,
    finish_time text,
    milliseconds bigint,
    fastest_lap int,
    fastest_lap_rank int,
    fastest_lap_time text,
    fastest_lap_speed double,
    status_id int,
    PRIMARY KEY (driver_id, race_id, result_id)
);

-- lap_times_by_race_driver: Lap-by-lap times. Partition = (race, driver) so one driver's race is a single partition.
-- Query: Get all laps of one driver in one race in lap order.
CREATE TABLE IF NOT EXISTS f1_analysis.lap_times_by_race_driver (
    race_id int,
    driver_id int,
    lap int,
    lap_position int,
    lap_time text,
    milliseconds int,
    PRIMARY KEY ((race_id, driver_id), lap)
);

-- pit_stops_by_race: Pit stops, partitioned by race.
-- Query: Get every pit stop of one race.
CREATE TABLE IF NOT EXISTS f1_analysis.pit_stops_by_race (
    race_id int,
    driver_id int,
    stop int,
    lap int,
    time_of_day text,
    milliseconds int,
    PRIMARY KEY (race_id, driver_id, stop)
);

-- qualifying_by_race: Qualifying results, partitioned by race.
-- Query: Get the qualifying session of one race.
CREATE TABLE IF NOT EXISTS f1_analysis.qualifying_by_race (
    qualify_id int,
    race_id int,
    driver_id int,
    constructor_id int,
    car_number int,
    position int,
    q1 text,
    q2 text,
    q3 text,
    PRIMARY KEY (race_id, qualify_id)
);

-- driver_standings_by_race: Championship standings after each race (drivers).
-- Query: Driver standings after a given race.
CREATE TABLE IF NOT EXISTS f1_analysis.driver_standings_by_race (
    standings_id int,
    race_id int,
    driver_id int,
    points double,
    position int,
    position_text text,
    wins int,
    PRIMARY KEY (race_id, driver_id)
);

-- constructor_standings_by_race: Championship standings after each race (constructors).
-- Query: Constructor standings after a given race.
CREATE TABLE IF NOT EXISTS f1_analysis.constructor_standings_by_race (
    standings_id int,
    race_id int,
    constructor_id int,
    points double,
    position int,
    position_text text,
    wins int,
    PRIMARY KEY (race_id, constructor_id)
);

-- ingestion_log: one row per dataset table, written by the ingestion script after a load.
CREATE TABLE IF NOT EXISTS f1_analysis.ingestion_log (
    table_name text PRIMARY KEY,
    source_file text,
    source_sha256 text,
    rows_read int,
    rows_written int,
    rows_skipped int,
    status text,
    message text,
    finished_at timestamp
);
